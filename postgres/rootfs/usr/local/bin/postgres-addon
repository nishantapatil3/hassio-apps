#!/bin/sh
# Read HA add-on options and launch PostgreSQL.

OPTIONS_FILE="/data/options.json"

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="homeassistant"
POSTGRES_DB="postgres"

if [ -f "$OPTIONS_FILE" ]; then
    POSTGRES_USER=$(jq -r '.POSTGRES_USER // "postgres"' "$OPTIONS_FILE")
    POSTGRES_PASSWORD=$(jq -r '.POSTGRES_PASSWORD // "homeassistant"' "$OPTIONS_FILE")
    POSTGRES_DB=$(jq -r '.POSTGRES_DB // "postgres"' "$OPTIONS_FILE")
fi

export POSTGRES_USER
export POSTGRES_PASSWORD
[ -n "$POSTGRES_DB" ] && export POSTGRES_DB

# Store data in HA persistent data volume so it survives add-on updates.
export PGDATA="/data/postgresql"

echo "Starting PostgreSQL 18 (user=${POSTGRES_USER}, pgdata=${PGDATA})..."

docker-entrypoint.sh postgres &
POSTGRES_PID=$!

cleanup() {
    kill "$POSTGRES_PID" 2>/dev/null || true
    wait "$POSTGRES_PID" 2>/dev/null || true
}

trap cleanup INT TERM

until pg_isready -h 127.0.0.1 -p 5432 -U "$POSTGRES_USER" > /dev/null 2>&1; do
    if ! kill -0 "$POSTGRES_PID" 2>/dev/null; then
        wait "$POSTGRES_PID"
    fi
    sleep 1
done

if [ -n "$POSTGRES_DB" ]; then
    echo "Ensuring PostgreSQL database exists: ${POSTGRES_DB}"
    PGPASSWORD="$POSTGRES_PASSWORD" createdb \
        -h 127.0.0.1 \
        -p 5432 \
        -U "$POSTGRES_USER" \
        --if-not-exists \
        "$POSTGRES_DB"
fi

wait "$POSTGRES_PID"
