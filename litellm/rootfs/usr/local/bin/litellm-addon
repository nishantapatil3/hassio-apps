#!/usr/bin/env python3
"""Start LiteLLM proxy from a user-provided configuration file."""

from __future__ import annotations

import json
import os
from pathlib import Path
import secrets
import shutil
import sys

DATA_DIR = Path(os.environ.get("LITELLM_ADDON_DATA", "/data"))
CONFIG_DIR = Path(os.environ.get("LITELLM_ADDON_CONFIG", "/config"))
CONFIG_FILE = CONFIG_DIR / "litellm.yaml"
SALT_KEY_PATH = DATA_DIR / "salt_key"
CHATGPT_TOKEN_DIR = DATA_DIR / "chatgpt"
GUARDRAIL_DIR = Path("/usr/local/lib/litellm-addon")
BUNDLED_CONFIG = Path("/etc/litellm-addon/litellm.yaml")
OPTIONS_FILE = Path("/data/options.json")
POSTGRES_PORT = 5432
POSTGRES_USER = "postgres"
POSTGRES_PASSWORD = "homeassistant"
POSTGRES_DATABASE = "litellm"


def get_salt_key() -> str:
    """Create a stable per-installation salt key if one does not exist."""
    if SALT_KEY_PATH.exists():
        return SALT_KEY_PATH.read_text(encoding="utf-8").strip()
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    salt_key = f"sk-salt-{secrets.token_hex(32)}"
    SALT_KEY_PATH.write_text(f"{salt_key}\n", encoding="utf-8")
    SALT_KEY_PATH.chmod(0o600)
    return salt_key


def get_options() -> dict:
    """Read HA add-on options from options.json."""
    if OPTIONS_FILE.exists():
        return json.loads(OPTIONS_FILE.read_text(encoding="utf-8"))
    return {}


def configure_environment() -> None:
    """Set the auto-generated salt key and any user-configured options."""
    os.environ["LITELLM_SALT_KEY"] = get_salt_key()
    persistent_home = DATA_DIR / "home"
    persistent_directories = {
        "HOME": persistent_home,
        "XDG_CONFIG_HOME": persistent_home / ".config",
        "XDG_DATA_HOME": persistent_home / ".local/share",
        "XDG_STATE_HOME": persistent_home / ".local/state",
    }
    for variable, directory in persistent_directories.items():
        directory.mkdir(parents=True, exist_ok=True)
        directory.chmod(0o700)
        os.environ[variable] = str(directory)
    CHATGPT_TOKEN_DIR.mkdir(parents=True, exist_ok=True)
    CHATGPT_TOKEN_DIR.chmod(0o700)
    os.environ["CHATGPT_TOKEN_DIR"] = str(CHATGPT_TOKEN_DIR)
    options = get_options()
    master_key = options.get("master_key", "").strip()
    if master_key:
        os.environ["LITELLM_MASTER_KEY"] = master_key
    database_host = options.get("database_host", "").strip()
    if database_host:
        os.environ["DATABASE_URL"] = (
            f"postgresql://{POSTGRES_USER}:{POSTGRES_PASSWORD}"
            f"@{database_host}:{POSTGRES_PORT}/{POSTGRES_DATABASE}"
        )
    server_root_path = options.get("server_root_path", "").strip()
    if server_root_path:
        os.environ["SERVER_ROOT_PATH"] = server_root_path


def main() -> int:
    """Copy default config if needed, then exec LiteLLM."""
    if not CONFIG_FILE.exists():
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        shutil.copy(BUNDLED_CONFIG, CONFIG_FILE)
        print(
            f"Default configuration written to {CONFIG_FILE}.\n"
            "Edit the file to set master_key, api keys, and other settings,\n"
            "then restart the add-on.",
            file=sys.stderr,
            flush=True,
        )
        return 1

    configure_environment()
    python_path = os.environ.get("PYTHONPATH", "")
    os.environ["PYTHONPATH"] = f"{GUARDRAIL_DIR}:{python_path}".rstrip(":")
    print(f"Starting LiteLLM with configuration: {CONFIG_FILE}", flush=True)
    os.execvp("litellm", [
        "litellm",
        "--config", str(CONFIG_FILE),
        "--host", "0.0.0.0",
        "--port", "4000",
    ])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
